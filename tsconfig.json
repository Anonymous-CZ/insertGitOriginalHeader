{
	"compilerOptions": {
		"module": "Node16",
		"target": "ES2022",
		"outDir": "./dist",  // 添加这一行
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"esModuleInterop": true
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}