{
  "name": "insertGitOriginalHeader",
  "displayName": "git-original-author-header",
  "description": "用于补充 koroFileHeader 的 VS Code 插件：当需要为他人提交的文件补充文件头注释时，koroFileHeader 无法直接获取文件的原始提交作者会很麻烦；本插件通过 Git 历史自动获取原始作者与时间并插入文件头。",
  "license": "MIT",
  "author": "Anonymous-CZ",
  "homepage": "https://github.com/Anonymous-CZ/insertGitOriginalHeader#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anonymous-CZ/insertGitOriginalHeader.git"
  },
  "bugs": {
    "url": "https://github.com/Anonymous-CZ/insertGitOriginalHeader/issues"
  },
  "version": "1.1.3",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:git-original-author-header.insertGitOriginalHeader",
    "onCommand:git-original-author-header.batchInsertMissingHeadersInFolder"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "git-original-author-header.insertGitOriginalHeader",
        "title": "插入Git原始作者文件头"
      },
      {
        "command": "git-original-author-header.batchInsertMissingHeadersInFolder",
        "title": "批量补充文件头注释"
      }
    ],
    "configuration": {
      "title": "git-original-author-header",
      "properties": {
        "git-original-author-header.commentStyleByLanguage": {
          "type": "object",
          "default": {},
          "description": "按 languageId 覆盖文件头注释风格映射（示例：{ \"python\": \"hashLine\", \"typescript\": \"cBlock\" }）。",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "htmlBlock",
              "cBlock",
              "slashLine",
              "hashLine",
              "powershellBlock",
              "luaBlock"
            ]
          }
        },
        "git-original-author-header.commentStyleByExtension": {
          "type": "object",
          "default": {},
          "description": "按文件扩展名覆盖文件头注释风格映射（key 可用 .ts 或 ts）。",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "htmlBlock",
              "cBlock",
              "slashLine",
              "hashLine",
              "powershellBlock",
              "luaBlock"
            ]
          }
        },
        "git-original-author-header.unknownFileBehavior": {
          "type": "string",
          "enum": [
            "prompt",
            "skip",
            "fallback"
          ],
          "default": "skip",
          "description": "无法识别注释方式时的行为：prompt=弹窗选择，skip=跳过并提示，fallback=使用默认块注释（cBlock）。"
        },
        "git-original-author-header.batchConcurrency": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "批量补充文件头时的最大并发数，用于避免同时执行过多 Git/IO 操作。"
        },
        "git-original-author-header.batchExcludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/pnpm-lock.yaml",
            "**/package-lock.json",
            "**/yarn.lock"
          ],
          "items": {
            "type": "string"
          },
          "description": "批量补充文件头时需要排除的 glob 模式。"
        },
        "git-original-author-header.batchIncludeExtensions": {
          "type": "array",
          "default": [
            ".ts",
            ".js",
            ".jsx",
            ".tsx",
            ".py",
            ".java",
            ".go",
            ".rs",
            ".html",
            ".css",
            ".scss",
            ".vue",
            ".md",
            ".xml",
            ".yml",
            ".yaml",
            ".toml",
            ".sh",
            ".ps1"
          ],
          "items": {
            "type": "string"
          },
          "description": "批量补充文件头时允许处理的文件扩展名白名单（为空表示不过滤扩展名）。"
        },
        "git-original-author-header.commentCheckLines": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 200,
          "description": "检测文件是否已有文件头注释时，读取并检查文件前 N 行。"
        },
        "git-original-author-header.skipBinaryFiles": {
          "type": "boolean",
          "default": true,
          "description": "批量补充文件头时是否自动跳过二进制文件。"
        },
        "git-original-author-header.continueOnError": {
          "type": "boolean",
          "default": false,
          "description": "批量处理过程中遇到失败时是否继续处理后续文件（false=遇到首个错误立即停止）。"
        },
        "git-original-author-header.generateReport": {
          "type": "boolean",
          "default": true,
          "description": "批量处理结束后是否生成可复制的处理报告。"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "git-original-author-header.insertGitOriginalHeader",
          "group": "1_modification"
        }
      ],
      "explorer/context": [
        {
          "command": "git-original-author-header.batchInsertMissingHeadersInFolder",
          "when": "explorerResourceIsFolder",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && node esbuild.js --production",
    "vsix": "pnpm run package && vsce package",
    "publish": "pnpm run vsix",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/vsce": "^3.7.1"
  },
  "dependencies": {}
}